# Production reverse proxy (Story 7.5).
#
# Caddy obtains and renews certificates from Let's Encrypt automatically, so there is no
# provider SDK, no certbot cron, and no manual renewal step. AD-15 still holds: the only
# thing this needs is DOMAIN and an email, both from the environment.
#
# The client and the API are served from the SAME origin here. That is deliberate and it
# removes CORS from production entirely — the browser never makes a cross-origin request,
# so there is no preflight and no origin allowlist to get wrong. CORS_ORIGINS matters only
# for local development, where the Vite dev server is on a different port.

{
	email {$ACME_EMAIL}
	# Uncomment to rehearse against Let's Encrypt's staging CA, which has far softer rate
	# limits. Get a certificate here before pointing the real one at a broken config.
	# acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
}

{$DOMAIN} {
	encode zstd gzip

	header {
		# HSTS. Once a browser has seen this it will refuse plain HTTP for the domain, so
		# do not enable preload until you are certain the domain stays on HTTPS forever.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		# The app loads one bundle and one stylesheet from its own origin, talks only to
		# its own /api, and embeds only the YouTube nocookie player (frame-src). Everything below is what it actually needs;
		# there is no 'unsafe-inline' because the build produces no inline script.
		# worker-src and manifest-src are named explicitly rather than left to default-src:
		# both fall back to it today, but a future relaxation of default-src should not
		# silently widen where a service worker may come from.
		Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; frame-src https://www.youtube-nocookie.com; img-src 'self' data:; connect-src 'self'; form-action 'self'; worker-src 'self'; manifest-src 'self'"
		# Do not advertise the server version.
		-Server
	}

	handle /api/* {
		reverse_proxy api:8000
	}

	# Proxied explicitly. Without this the SPA fallback below answers /health with
	# index.html and a 200, so an uptime monitor would report the service healthy while
	# the API and the database were both dead.
	handle /health {
		reverse_proxy api:8000
	}

	# The service worker must not be cached, or a browser holding an old copy keeps serving
	# an old app and no deploy ever reaches it. Browsers already bypass the HTTP cache for
	# worker scripts, but proxies in between do not.
	@sw path /sw.js
	header @sw Cache-Control "no-cache, no-store, must-revalidate"

	# AD-66: the marketing landing. "/" is the landing for a visitor, who has no ee_app=1
	# cookie (a routing hint the client sets while a refresh token exists, never a
	# credential) and no query string. Any query (?invite=, ?mood=1, ?pwa=1) is an app link
	# and stays on the SPA. The cookie regex tolerates other cookies on either side and
	# rejects look-alikes such as ee_app=10. This is rewritten to the prerendered
	# /landing.html, served by the file_server below.
	@landing {
		path /
		not header_regexp Cookie (^|;\s*)ee_app=1(;|$)
		query ""
	}
	# The header is matched BEFORE the rewrite runs (header sorts ahead of rewrite), so it
	# is only set when the landing is served: the app at "/" for a cookie holder must NOT
	# carry X-EE-Page, or the service worker refuses to cache it as the app shell.
	header @landing X-EE-Page "landing"
	header @landing Cache-Control "no-cache"
	rewrite @landing /landing.html

	# AD-66: every other landing document, with the same two headers.
	@landingdocs path /landing.html /fr/ /fr/index.html /privacy/ /privacy/index.html /fr/privacy/ /fr/privacy/index.html
	header @landingdocs X-EE-Page "landing"
	header @landingdocs Cache-Control "no-cache"

	# AD-66: the slash-less forms redirect to the directory form the build emits.
	@landingslash path /fr /privacy /fr/privacy
	redir @landingslash {path}/ 308

	# index.html likewise: it names the hashed bundles, so a cached copy pins the app to an
	# old build.
	@shell path / /index.html /manifest.webmanifest
	header @shell Cache-Control "no-cache"

	# The bundles themselves are content-hashed, so a changed file is a new URL and these
	# can be cached indefinitely.
	@hashed path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	# SPA fallback: deep links like /entries are routed by the client, so anything that is
	# not a real file returns index.html rather than a 404.
	handle {
		root * /srv
		# {path}index.html makes /fr/ and /privacy/ explicit (AD-66); the last entry is
		# still the SPA fallback for everything else.
		try_files {path} {path}index.html /index.html
		file_server
	}
}
